NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/tms_erp

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

SEED_ADMIN_EMAIL=admin@tms.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Super Admin

# Optional Redis (BullMQ). If unset/unavailable, jobs gracefully no-op.
REDIS_URL=redis://127.0.0.1:6379

# Optional SMTP (falls back to Ethereal test account in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TMS <noreply@tms.local>

# Optional Cloudinary (local disk uploads used when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local upload directory (relative to server cwd or absolute)
UPLOAD_DIR=uploads

# GPS location write throttle hint (ms)
LOCATION_THROTTLE_MS=5000
